{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verigence-vineeti",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  // Each dealership reaches VINeeti at its own address, grouped by manufacturer:
  // <dealership>.<oem>.jbrconsulting.in. A Custom Domain makes the Worker the origin for that exact
  // hostname, so Cloudflare creates the DNS record and the certificate and there is nothing to set up
  // by hand or renew. The depth is fine: a Custom Domain gets a certificate for its own hostname,
  // including a multi-level one, where Universal SSL would only have covered the first level.
  //
  // One line per dealership. The workers.dev address keeps working alongside these.
  // Kept on explicitly. Declaring any route turns the workers.dev address off by default, and that
  // address is the one the dealership is using today: losing it is an outage, not a tidy-up.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "adityamotors.mh.jbrconsulting.in",
      "custom_domain": true
    }
  ],

  // Where a support ticket's attachment is kept. The deployment creates the bucket if it is missing.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "verigence-vineeti-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verigence-vineeti",
      // Filled in at deployment: scripts/deploy.mjs finds (or creates) the database and writes its ID into a
      // generated copy of this file. Local development does not need it.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 15 minutes: payment-window timers, alarms, WhatsApp retries, allocation sweep, day-end reconciliation.
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "APP_NAME": "VINeeti",
    "WA_GRAPH_VERSION": "v23.0"
  },
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`): SESSION_SECRET, DATA_KEY, PLATFORM_ADMIN_TOKEN
}
